<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.deflight.buttonmapper"
    android:versionCode="4"
    android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />
    <!-- this head unit's activity manager checks GET_TASKS even in Activity.finish() -->
    <uses-permission android:name="android.permission.GET_TASKS" />
    <!-- only apps signed like this one may ask the hook in the car's home menu to open things -->
    <permission android:name="com.deflight.buttonmapper.permission.OPEN" android:protectionLevel="signature" />
    <uses-permission android:name="com.deflight.buttonmapper.permission.OPEN" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher" android:allowBackup="false">
        <activity android:name=".Setup" android:label="@string/app_name" android:exported="true"
            android:theme="@android:style/Theme.Holo.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
        <receiver android:name=".Keys">
            <intent-filter>
                <action android:name="com.deflight.buttonmapper.PRESS" />
                <action android:name="com.deflight.buttonmapper.PHONE" />
                <action android:name="com.deflight.buttonmapper.PROFILE" />
                <action android:name="com.deflight.buttonmapper.FOUND" />
                <action android:name="com.deflight.buttonmapper.STAR_HU" />
                <action android:name="com.deflight.buttonmapper.STAR_WHEEL" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
